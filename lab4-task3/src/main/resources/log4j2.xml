<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Properties><Property name="logDir">${sys:lab.logDir:-logs}</Property></Properties>
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout charset="UTF-8" disableAnsi="false" pattern="%d{HH:mm:ss} %highlight{%-5level}{ERROR=red bold, WARN=yellow, INFO=green, DEBUG=cyan} %c{1} - %msg%n"/>
    </Console>
    <RollingFile name="All" fileName="${logDir}/application.log" filePattern="${logDir}/archive/application-%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout charset="UTF-8" pattern="%d{ISO8601} %-5level %c - %msg%n"/>
      <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="1 MB"/></Policies>
      <DefaultRolloverStrategy max="7"/>
    </RollingFile>
    <RollingFile name="Warnings" fileName="${logDir}/warnings.log" filePattern="${logDir}/archive/warnings-%d{yyyy-MM-dd}-%i.log.gz">
      <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/>
      <PatternLayout charset="UTF-8" pattern="%d{ISO8601} %-5level %c - %msg%n"/>
      <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="1 MB"/></Policies>
      <DefaultRolloverStrategy max="7"/>
    </RollingFile>
    <RollingFile name="Errors" fileName="${logDir}/errors.log" filePattern="${logDir}/archive/errors-%d{yyyy-MM-dd}-%i.log.gz">
      <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
      <PatternLayout charset="UTF-8" pattern="%d{ISO8601} %-5level %c - %msg%n"/>
      <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="1 MB"/></Policies>
      <DefaultRolloverStrategy max="7"/>
    </RollingFile>
  </Appenders>
  <Loggers><Root level="debug"><AppenderRef ref="Console"/><AppenderRef ref="All"/><AppenderRef ref="Warnings"/><AppenderRef ref="Errors"/></Root></Loggers>
</Configuration>
